{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out-tsc/electron",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "baseUrl": "."
  },
  "include": ["electron/**/*.ts", "electron/**/*.tsx"]
}
